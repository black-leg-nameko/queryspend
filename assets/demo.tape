Output assets/demo.gif

Set Shell "bash"
Set FontSize 17
Set Width 1200
Set Height 760
Set TypingSpeed 35ms
Set Theme { "name": "queryspend", "black": "#10161D", "red": "#F87171", "green": "#5EEAD4", "yellow": "#FBBF24", "blue": "#60A5FA", "magenta": "#C084FC", "cyan": "#22D3EE", "white": "#E5EDF5", "brightBlack": "#526273", "brightRed": "#FCA5A5", "brightGreen": "#99F6E4", "brightYellow": "#FDE68A", "brightBlue": "#93C5FD", "brightMagenta": "#D8B4FE", "brightCyan": "#67E8F9", "brightWhite": "#F8FAFC", "background": "#10161D", "foreground": "#E5EDF5", "selectionBackground": "#334155", "cursorAccent": "#10161D" }

Type "uv run queryspend demo"
Sleep 300ms
Enter
Sleep 5s
